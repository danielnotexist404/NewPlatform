# Copy to .env.local and fill in. Without OPENROUTER_API_KEY the app uses a built-in demo script and placeholder art.
# Server-only: these are read by app/api/generate/* and never sent to the browser.
OPENROUTER_API_KEY=
# Hebrew script writer (chat completions with json_schema output)
OPENROUTER_SCRIPT_MODEL=anthropic/claude-sonnet-5.5
# Scene images (chat completions with modalities ["image","text"])
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
